{
  "name": "dsh-runner",
  "version": "0.7.0",
  "private": false,
  "description": "DSH 客户端插件 dsh-runner：输入框下方「运行」小按钮 + 设置页紧凑命令配置；配置存 Host 侧并提供 dsh_runner_config 工具，让 AI 可在任意项目直接创建启动命令。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host-config.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js && node --check host-config.js && node scripts/host-smoke.mjs && node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "terminal",
    "run-button",
    "limob"
  ],
  "author": "lcx19970714",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcx19970714/dsh-runner.git"
  },
  "homepage": "https://github.com/lcx19970714/dsh-runner",
  "bugs": {
    "url": "https://github.com/lcx19970714/dsh-runner/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
