{
  "name": "dsh-runner",
  "version": "0.12.0",
  "private": false,
  "description": "DSH 插件 dsh-runner：左侧「运行」面板按项目启停服务（状态/端口/日志/重启/依赖），输入框下方保留运行快捷菜单，并提供 dsh_runner_config / dsh_runner_run AI 工具。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host-config.js",
    "host-runner.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js && node --check host-config.js && node --check host-runner.js && node scripts/host-smoke.mjs && node scripts/runner-smoke.mjs && node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "run-panel",
    "process-manager",
    "dev-server",
    "terminal"
  ],
  "author": "lcx19970714",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcx19970714/dsh-runner.git"
  },
  "homepage": "https://github.com/lcx19970714/dsh-runner",
  "bugs": {
    "url": "https://github.com/lcx19970714/dsh-runner/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
